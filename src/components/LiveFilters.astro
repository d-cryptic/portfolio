---
import type { ExplorerItem } from "@lib/live-filters";

const { items } = Astro.props as { items: ExplorerItem[] };

const uniqueSortedValues = (values: string[]): string[] =>
  [...new Set(values)].sort((a, b) => a.localeCompare(b));

const stacks = uniqueSortedValues(items.flatMap((item) => item.stack));
const roles = uniqueSortedValues(items.flatMap((item) => item.roles));
const outcomes = uniqueSortedValues(items.flatMap((item) => item.outcomes));
const types = uniqueSortedValues(items.map((item) => item.contentType));
const tags = uniqueSortedValues(items.flatMap((item) => item.tags));

const getFilters = (values: string[]): string =>
  values
    .map((value) => value.toLowerCase().trim())
    .filter(Boolean)
    .join("|");

const formatItemDate = (date: Date): string =>
  new Intl.DateTimeFormat("en", {
    month: "short",
    day: "2-digit",
    year: "numeric",
  }).format(date);
---

<section class="animate explorer-workbench" data-live-filters>
  <div class="explorer-grid">
    <div class="explorer-controls">
      <div class="explorer-controls__head">
        <p>Filter Console</p>
        <button type="button" data-clear-filters>Reset</button>
      </div>

      <div class="explorer-query">
        <label for="explorer-query">Search Query</label>
        <input
          id="explorer-query"
          data-query-input
          type="text"
          placeholder="#devops @blog outcome:infra"
        />
        <div class="explorer-syntax">
          <code>#tag</code>
          <code>@type</code>
          <code>stack:</code>
          <code>role:</code>
          <code>outcome:</code>
          <code>since:</code>
          <code>until:</code>
        </div>
        <div data-suggestions-root class="explorer-suggestions hidden"></div>
      </div>

      <div class="explorer-date-grid">
        <label>
          <span>From</span>
          <input id="explorer-since" data-since-input type="date" />
        </label>
        <label>
          <span>Until</span>
          <input id="explorer-until" data-until-input type="date" />
        </label>
      </div>

      <div class="explorer-presets">
        <p>Quick Views</p>
        <div>
          <button type="button" data-preset-query="outcome:performance">
            Performance
          </button>
          <button type="button" data-preset-query="outcome:seo">SEO</button>
          <button type="button" data-preset-query="outcome:infra">Infra</button>
          <button type="button" data-preset-query="outcome:data">Data</button>
        </div>
      </div>

      <div class="explorer-facets">
        <details open>
          <summary>Type</summary>
          <div>
            {
              types.map((value) => (
                <button
                  type="button"
                  data-facet-button
                  data-facet-group="types"
                  data-facet-value={value}
                  aria-pressed="false"
                >
                  {value} (<span data-facet-count>{0}</span>)
                </button>
              ))
            }
          </div>
        </details>

        <details open>
          <summary>Stack</summary>
          <div>
            {
              stacks.map((value) => (
                <button
                  type="button"
                  data-facet-button
                  data-facet-group="stack"
                  data-facet-value={value}
                  aria-pressed="false"
                >
                  {value} (<span data-facet-count>{0}</span>)
                </button>
              ))
            }
          </div>
        </details>

        <details>
          <summary>Role</summary>
          <div>
            {
              roles.map((value) => (
                <button
                  type="button"
                  data-facet-button
                  data-facet-group="roles"
                  data-facet-value={value}
                  aria-pressed="false"
                >
                  {value} (<span data-facet-count>{0}</span>)
                </button>
              ))
            }
          </div>
        </details>

        <details open>
          <summary>Outcome</summary>
          <div>
            {
              outcomes.map((value) => (
                <button
                  type="button"
                  data-facet-button
                  data-facet-group="outcomes"
                  data-facet-value={value}
                  aria-pressed="false"
                >
                  {value} (<span data-facet-count>{0}</span>)
                </button>
              ))
            }
          </div>
        </details>

        <details>
          <summary>Tags</summary>
          <div>
            {
              tags.map((value) => (
                <button
                  type="button"
                  data-facet-button
                  data-facet-group="tags"
                  data-facet-value={value}
                  aria-pressed="false"
                >
                  #{value} (<span data-facet-count>{0}</span>)
                </button>
              ))
            }
          </div>
        </details>
      </div>
    </div>

    <div class="explorer-results">
      <div class="explorer-results__head">
        <div>
          <p>Results</p>
          <strong><span data-result-count>{items.length}</span> matches</strong>
        </div>
        <span>{items.length} indexed</span>
      </div>

      <ul class="not-prose explorer-results__list" data-filter-results>
        {
          items.map((item) => (
            <li
              data-filter-item
              data-title={item.title.toLowerCase()}
              data-description={item.description.toLowerCase()}
              data-href={item.href.toLowerCase()}
              data-date={item.date.toISOString().slice(0, 10)}
              data-type={item.contentType.toLowerCase()}
              data-tags={getFilters(item.tags)}
              data-stack={getFilters(item.stack)}
              data-roles={getFilters(item.roles)}
              data-outcomes={getFilters(item.outcomes)}
            >
              <a href={item.href} class="explorer-result-card">
                <span class="explorer-result-card__glow" aria-hidden="true" />
                <span class="explorer-result-card__meta">
                  <span>{item.contentType}</span>
                  <span>{formatItemDate(item.date)}</span>
                </span>
                <span class="explorer-result-card__title">
                  {item.title}
                  <span aria-hidden="true">-&gt;</span>
                </span>
                <span class="explorer-result-card__description">
                  {item.description}
                </span>
                <span class="explorer-result-card__chips">
                  {item.stack.slice(0, 2).map((value) => (
                    <span>stack:{value}</span>
                  ))}
                  {item.outcomes.slice(0, 2).map((value) => (
                    <span>outcome:{value}</span>
                  ))}
                  {item.tags.slice(0, 3).map((value) => (
                    <span>#{value}</span>
                  ))}
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <p data-empty-state class="explorer-empty hidden">
        No items match. Try broadening the query, removing exclusions, or
        clearing date bounds.
      </p>
    </div>
  </div>
</section>

<style>
  .explorer-workbench {
    margin-bottom: 2rem;
  }

  .explorer-grid {
    display: grid;
    gap: 1rem;
  }

  .explorer-controls,
  .explorer-results {
    min-width: 0;
    border: 1px solid color-mix(in srgb, var(--color-text) 16%, transparent);
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--color-background) 96%, white);
  }

  .explorer-controls {
    display: grid;
    gap: 1rem;
    padding: 1rem;
    align-self: start;
  }

  .explorer-controls__head,
  .explorer-results__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-text) 12%, transparent);
    padding-bottom: 0.8rem;
  }

  .explorer-controls__head p,
  .explorer-results__head p,
  .explorer-presets p {
    margin: 0;
    color: color-mix(in srgb, var(--color-text) 58%, transparent);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .explorer-controls__head button,
  .explorer-presets button,
  .explorer-facets button {
    border: 1px solid color-mix(in srgb, var(--color-text) 18%, transparent);
    border-radius: 999px;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    font: inherit;
    transition:
      border-color 160ms ease,
      background-color 160ms ease,
      color 160ms ease;
  }

  .explorer-controls__head button {
    padding: 0.35rem 0.65rem;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .explorer-query {
    display: grid;
    gap: 0.55rem;
  }

  .explorer-query label,
  .explorer-date-grid span {
    color: color-mix(in srgb, var(--color-text) 60%, transparent);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .explorer-query input,
  .explorer-date-grid input {
    width: 100%;
    min-width: 0;
    border: 1px solid color-mix(in srgb, var(--color-text) 20%, transparent);
    border-radius: 0.4rem;
    background: var(--color-background);
    color: var(--color-text);
    padding: 0.72rem 0.8rem;
    font: inherit;
    outline: none;
  }

  .explorer-query input::placeholder {
    color: color-mix(in srgb, var(--color-text) 42%, transparent);
    font-size: 0.9rem;
  }

  .explorer-query input:focus,
  .explorer-date-grid input:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px
      color-mix(in srgb, var(--color-primary) 14%, transparent);
  }

  .explorer-syntax,
  .explorer-presets div,
  .explorer-facets details > div,
  .explorer-result-card__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .explorer-syntax code,
  .explorer-result-card__chips span {
    border: 1px solid color-mix(in srgb, var(--color-text) 14%, transparent);
    border-radius: 999px;
    padding: 0.18rem 0.45rem;
    color: color-mix(in srgb, var(--color-text) 68%, transparent);
    font-size: 0.72rem;
  }

  .explorer-suggestions {
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-text) 14%, transparent);
    border-radius: 0.4rem;
  }

  .explorer-date-grid {
    display: grid;
    gap: 0.65rem;
  }

  .explorer-date-grid label {
    display: grid;
    gap: 0.35rem;
  }

  .explorer-presets {
    display: grid;
    gap: 0.55rem;
  }

  .explorer-presets button,
  .explorer-facets button {
    padding: 0.38rem 0.65rem;
    font-size: 0.78rem;
  }

  .explorer-controls__head button:hover,
  .explorer-controls__head button:focus-visible,
  .explorer-presets button:hover,
  .explorer-presets button:focus-visible,
  .explorer-facets button:hover,
  .explorer-facets button:focus-visible,
  .explorer-facets button[aria-pressed="true"] {
    border-color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 11%, transparent);
    color: var(--color-text);
  }

  .explorer-facets {
    display: grid;
    gap: 0.6rem;
  }

  .explorer-facets details {
    border-top: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent);
    padding-top: 0.65rem;
  }

  .explorer-facets summary {
    cursor: pointer;
    color: color-mix(in srgb, var(--color-text) 70%, transparent);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

