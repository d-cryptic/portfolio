---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import ProjectCard from "@components/ProjectCard.astro";
import { PROJECTS } from "@consts";
import { toContentPath } from "@lib/content-paths";
import { breadcrumbJsonLd, itemListJsonLd, toAbsoluteUrl } from "@lib/seo";

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const projectListItems = projects.map((project) => ({
  name: project.data.title,
  description: project.data.description,
  url: toAbsoluteUrl(toContentPath("projects", project.id)),
}));
---

<Layout
  title={PROJECTS.TITLE}
  description={PROJECTS.DESCRIPTION}
  keywords={["projects", "sre projects", "platform engineering projects"]}
  schema={[
    breadcrumbJsonLd([
      { name: "Home", path: "/" },
      { name: "Projects", path: "/projects" },
    ]),
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      name: PROJECTS.TITLE,
      description: PROJECTS.DESCRIPTION,
      url: toAbsoluteUrl("/projects"),
    },
    itemListJsonLd("Featured projects", projectListItems),
  ]}
>
  <Container>
    <aside data-pagefind-ignore>
      <div class="space-y-10">
        <div class="animate font-semibold text-black dark:text-white">
          Projects
        </div>
        <ul class="animate not-prose grid gap-4 sm:grid-cols-2">
          {
            projects.map((project) => (
              <li>
                <ProjectCard project={project} />
              </li>
            ))
          }
        </ul>
      </div>
    </aside>
  </Container>
</Layout>
