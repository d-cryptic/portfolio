---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { SITE } from "@consts";

const recoveryLinks = [
  { href: "/", label: "Home", detail: "Return to the main checkpoint." },
  { href: "/blog", label: "Blog", detail: "Read systems notes and writeups." },
  { href: "/projects", label: "Projects", detail: "Browse shipped work." },
  { href: "/explorer", label: "Explorer", detail: "Search the site map." },
];
---

<Layout title="404" description={SITE.DESCRIPTION} noindex={true}>
  <Container>
    <section class="not-found-shell">
      <div class="route-card">
        <div class="route-panel" aria-hidden="true">
          <div class="route-panel__bar">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <div class="route-panel__screen">
            <p class="route-panel__prompt">&gt; trace route</p>
            <pre>
START  /home
  |
  +-- /blog
  +-- /projects
  +-- /explorer
  |
  x-- /this-route

STATUS: 404
NEXT:   choose checkpoint</pre>
          </div>
        </div>

        <div class="route-copy">
          <p class="route-kicker">Route Missing</p>
          <h1>Wrong portal. Right site.</h1>
          <p>
            This URL does not map to a live page. Pick a stable checkpoint below
            and keep moving.
          </p>

          <div class="route-actions" aria-label="Recovery links">
            {
              recoveryLinks.map((link) => (
                <a href={link.href} class="route-link">
                  <span>{link.label}</span>
                  <small>{link.detail}</small>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </Container>
</Layout>

<style>
  .not-found-shell {
    min-height: calc(100vh - 10rem);
    display: grid;
    place-items: center;
    padding-block: clamp(1.5rem, 5vw, 4rem);
  }

  .route-card {
    width: min(100%, 64rem);
    display: grid;
    gap: 1rem;
    border: 1px solid color-mix(in srgb, var(--color-text) 18%, transparent);
    border-radius: 0.5rem;
    background:
      linear-gradient(
          90deg,
          color-mix(in srgb, var(--color-text) 4%, transparent) 1px,
          transparent 1px
        )
        0 0 / 2rem 2rem,
      linear-gradient(
          0deg,
          color-mix(in srgb, var(--color-text) 4%, transparent) 1px,
          transparent 1px
        )
        0 0 / 2rem 2rem,
      var(--color-background);
    padding: clamp(0.9rem, 3vw, 1.5rem);
    box-shadow: 8px 8px 0
      color-mix(in srgb, var(--color-primary) 55%, transparent);
  }

  .route-panel {
    min-width: 0;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-text) 20%, transparent);
    border-radius: 0.45rem;
    background: color-mix(in srgb, var(--color-background) 88%, white);
  }

  .route-panel__bar {
    display: flex;
    gap: 0.4rem;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-text) 16%, transparent);
    padding: 0.65rem;
  }

  .route-panel__bar span {
    width: 0.65rem;
    height: 0.65rem;
    border: 1px solid color-mix(in srgb, var(--color-text) 30%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-primary) 35%, transparent);
  }

  .route-panel__screen {
    padding: clamp(0.9rem, 3vw, 1.25rem);
  }

  .route-panel__prompt {
    margin: 0 0 0.75rem;
    color: var(--color-primary);
    font-weight: 700;
  }

  .route-panel pre {
    margin: 0;
    overflow: auto;
    font-size: clamp(0.78rem, 2.6vw, 0.95rem);
    line-height: 1.45;
    white-space: pre-wrap;
  }

  .route-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .route-kicker {
    margin: 0 0 0.5rem;
    color: var(--color-primary);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .route-copy h1 {
    margin: 0;
    color: var(--color-text);
    font-size: clamp(2rem, 7vw, 3rem);
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.02;
    text-wrap: balance;
  }

  .route-copy p:not(.route-kicker) {
    max-width: 34rem;
    margin: 1rem 0 0;
    color: color-mix(in srgb, var(--color-text) 72%, transparent);
    font-size: clamp(0.95rem, 2.6vw, 1.05rem);
    line-height: 1.65;
  }

  .route-actions {
    display: grid;
    gap: 0.65rem;
    margin-top: 1.4rem;
  }

  .route-link {
    display: grid;
    gap: 0.1rem;
    border: 1px solid color-mix(in srgb, var(--color-text) 18%, transparent);
    border-radius: 0.4rem;
    padding: 0.85rem;
    text-decoration: none;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      transform 180ms ease;
  }

  .route-link:hover,
  .route-link:focus-visible {
    border-color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 9%, transparent);
    color: var(--color-text);
    transform: translateY(-1px);
  }

  .route-link span {
    color: var(--color-text);
    font-weight: 800;
  }

  .route-link small {
    color: color-mix(in srgb, var(--color-text) 62%, transparent);
    font-size: 0.8rem;
    line-height: 1.4;
  }

  @media (min-width: 700px) {
    .route-card {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: stretch;
      gap: 1.5rem;
    }

    .route-actions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 380px) {
    .route-card {
      box-shadow: 4px 4px 0
        color-mix(in srgb, var(--color-primary) 55%, transparent);
    }

    .route-actions {
      gap: 0.5rem;
    }
  }
</style>
