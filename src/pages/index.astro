---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { SITE, HOME, SOCIALS, RESUME_URL } from "@consts";
import { Image } from "astro:assets";
import BlogCard from "@components/BlogCard.astro";
import ProjectCard from "@components/ProjectCard.astro";
import LoreCarousel from "@components/LoreCarousel.astro";
import Link from "@components/Link.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Callout from "@components/Callout.astro";
import QuestStatCard from "@components/QuestStatCard.astro";
import { getBlogThumbnail } from "@lib/content-images";
import { breadcrumbJsonLd, toAbsoluteUrl } from "@lib/seo";
import { nowPageData } from "@data/now";
import { winsPageData } from "@data/personal-pages";

const allBlogPosts = (await getCollection("blog")).filter(
  (post) => !post.data.draft,
);

const blog = [...allBlogPosts]
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE)
  .map((post) => ({
    ...post,
    thumbnail: getBlogThumbnail(post.id, post.body),
  }));

const allProjects: CollectionEntry<"projects">[] = (
  await getCollection("projects")
).filter((project) => !project.data.draft);

const projects = [...allProjects]
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);

const workExperiences = [
  {
    designation: "Founding Engineer",
    organization: "LinkRunner",
    href: "https://linkrunner.io/",
    duration: "Nov'25 - Present",
    highlights: [
      "Rebuilt real-time attribution pipelines around Go, Kafka, ClickHouse, and Redis for high-volume event ingestion.",
      "Delivered major infra cost reductions across analytics, Kubernetes workloads, logging, and cloud migration work.",
      "Led platform reliability work across GKE, GitOps, ClickHouse operations, Redis recovery paths, and compliance evidence.",
    ],
    chips: ["Go", "ClickHouse", "Kafka", "GKE", "Redis", "Cost"],
  },
  {
    designation: "SRE/Platform Engineer",
    organization: "One2N",
    href: "https://one2n.io/",
    duration: "Jun'24 - Nov'25",
    highlights: [
      "Built hybrid cloud and Kubernetes platform work with EKS, Cilium, Istio, CoreDNS, ExternalDNS, and ingress routing.",
      "Reduced GenAI inference cost by moving workloads from managed APIs to self-hosted model serving on SageMaker.",
      "Scaled and hardened multi-cloud infrastructure with VPCs, load balancers, WAF rules, VPNs, CI/CD, and ISO/SOC2 work.",
    ],
    chips: ["EKS", "Cilium", "Istio", "SageMaker", "Terraform", "Security"],
  },
  {
    designation: "SRE/DevOps",
    organization: "Media.Net",
    href: "https://www.media.net/",
    duration: "Jul'23 - Jun'24",
    highlights: [
      "Built monitoring surfaces for production queueing pipelines with Django, Prometheus metrics, and Grafana dashboards.",
      "Handled zero-downtime GKE node-pool upgrades, production MySQL migration work, and Redis spot-node cost optimization.",
      "Improved registry reliability and cluster cost attribution with Artifact Registry migration and Stackdriver exporter work.",
    ],
    chips: ["GKE", "Prometheus", "Grafana", "MySQL", "Redis", "Django"],
  },
  {
    designation: "SRE Intern",
    organization: "Media.Net",
    href: "https://www.media.net/",
    duration: "Jan'23 - Jun'23",
    highlights: [
      "Built internal Terraform modules to standardize resource provisioning across environments.",
      "Migrated GitOps deployments from ArgoCD app-of-apps to ApplicationSet patterns for better environment scale.",
      "Integrated DriftCTL with Terraform and Atlantis to detect and manage infrastructure state drift.",
    ],
    chips: ["Terraform", "ArgoCD", "ApplicationSet", "Atlantis", "DriftCTL"],
  },
];
---

<Layout
  title={HOME.TITLE}
  description={HOME.DESCRIPTION}
  image="https://assets.barundebnath.com/about-me%20(1).png"
  keywords={[
    "SRE",
    "Full Stack Engineering",
    "AI Engineering",
    "Platform Engineering",
    "Systems Engineering",
    "DevOps",
    "Barun Debnath",
  ]}
  schema={[
    breadcrumbJsonLd([{ name: "Home", path: "/" }]),
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      name: HOME.TITLE,
      description: HOME.DESCRIPTION,
      url: toAbsoluteUrl("/"),
    },
  ]}
>
  <Container>
    <aside data-pagefind-ignore>
      <!-- Hero Section with progressive load -->
      <div class="progressive-load space-y-8" style="--load-order: 1">
        <div class="space-y-4">
          <Callout type="hi">
            <h1 class="font-semibold text-black dark:text-white">
              Hi, I am <b>Barun Debnath</b>
            </h1>
          </Callout>
          <p>
            I build <b>full-stack products</b>, <b>AI systems</b>, and the
            <b>platforms</b> that keep them reliable, observable, and scalable when
            real users show up.
          </p>
          <p>
            My lane sits where product engineering meets SRE: TypeScript and Go
            services, agent workflows, ClickHouse/Kafka data paths, Kubernetes
            platforms, and the reliability work behind them.
          </p>
        </div>
        <div class="flex w-full justify-center">
          <Image
            src="https://assets.barundebnath.com/about-me%20(1).png"
            alt="Ninja coding on laptop - Barun's digital avatar"
            class="h-auto w-full max-w-[800px] rounded-lg"
            width={800}
            height={800}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            sizes="(max-width: 800px) 100vw, 800px"
            widths={[320, 480, 640, 800]}
            format="webp"
          />
        </div>
        <div class="open-to-row">
          <span class="text-sm font-semibold text-black dark:text-white"
            >Open To Opportunities</span
          >
          <div class="open-to-marquee" aria-label="Open to opportunities">
            <div class="open-to-track">
              <ul class="open-to-list">
                {
                  nowPageData.openTo.map((item) => (
                    <li>
                      <span class="rounded-full border border-black/20 bg-black/[0.03] px-3 py-1 text-xs leading-none whitespace-nowrap dark:border-white/25 dark:bg-white/[0.04]">
                        {item}
                      </span>
                    </li>
                  ))
                }
              </ul>
              <ul class="open-to-list" aria-hidden="true">
                {
                  nowPageData.openTo.map((item) => (
                    <li>
                      <span class="rounded-full border border-black/20 bg-black/[0.03] px-3 py-1 text-xs leading-none whitespace-nowrap dark:border-white/25 dark:bg-white/[0.04]">
                        {item}
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
        <div class="grid gap-3 md:grid-cols-3">
          <QuestStatCard
            label="Current Arc"
            value="Full-stack x AI"
            detail="Shipping product experiences, agents, APIs, and the infra they depend on."
          />
          <QuestStatCard
            label="Main Class"
            value="Platform-minded builder"
            detail="Go, TypeScript, ClickHouse, Kafka, Kubernetes, and production debugging."
          />
          <QuestStatCard
            label="Side Quest"
            value="Writing Field Notes"
            detail="Turning systems, AI, and hard-earned reliability lessons into posts."
          />
        </div>
      </div>

      <div class="space-y-16">
        <!-- Work Experience Section -->
        <section class="progressive-load" style="--load-order: 2">
          <article class="space-y-5">
            <div>
              <Callout type="work">
                <b>What I've Been Up To</b>
              </Callout>
            </div>
            <div class="work-section-copy">
              Selected work across full-stack engineering, AI systems, platform
              reliability, and scalable infrastructure.
            </div>
            <div class="animate">
              <div class="not-prose experience-panel">
                <div class="experience-header" aria-hidden="true">
                  <span>Designation</span>
                  <span>Organization</span>
                  <span>Duration</span>
                  <span></span>
                </div>
                <div class="experience-list">
                  {
                    workExperiences.map((experience, index) => (
                      <details class="experience-item" open={index === 0}>
                        <summary>
                          <span>{experience.designation}</span>
                          <Link href={experience.href} external>
                            {experience.organization}
                          </Link>
                          <span>{experience.duration}</span>
                          <span class="experience-toggle" aria-hidden="true">
                            +
                          </span>
                        </summary>
                        <div class="experience-details">
                          <ul>
                            {experience.highlights.map((highlight) => (
                              <li>{highlight}</li>
                            ))}
                          </ul>
                          <div class="experience-chips">
                            {experience.chips.map((chip) => (
                              <span>{chip}</span>
                            ))}
                          </div>
                        </div>
                      </details>
                    ))
                  }
                </div>
              </div>
            </div>
            <p class="mt-4 flex flex-col gap-2">
              <span
                >From product surfaces and AI workflows to production
                reliability and scalable platforms, this is the operating range.</span
              >
              <span>
                Know more about my work experience from my <Link
                  href={RESUME_URL}
                  external>RESUME</Link
                >
              </span>
            </p>
          </article>
        </section>

        <LoreCarousel />

        <section class="animate space-y-6">
          <div class="flex flex-wrap items-end justify-between gap-3">
            <div>
              <p
                class="mb-1 text-xs tracking-wide text-black/55 uppercase dark:text-white/55"
              >
                Speaking
              </p>
              <h2 class="font-semibold text-black dark:text-white">
                Talk Delivered
              </h2>
            </div>
            <p
              class="max-w-md text-sm leading-relaxed text-black/70 dark:text-white/70"
            >
              {winsPageData.intro}
            </p>
          </div>
          <div
            class="rounded-lg border border-black/15 p-4 dark:border-white/20"
          >
            <p
              class="m-0 text-xs tracking-wide text-black/55 uppercase dark:text-white/55"
            >
              {winsPageData.featuredTalk.eyebrow}
            </p>
            <h3
              class="m-0 mt-2 text-lg leading-snug font-semibold text-black dark:text-white"
            >
              {winsPageData.featuredTalk.title}
            </h3>
            <p
              class="mt-3 text-sm leading-relaxed text-black/75 dark:text-white/75"
            >
              {winsPageData.featuredTalk.description}
            </p>
            <div
              class="mt-4 grid gap-3 border-t border-black/10 pt-4 text-sm md:grid-cols-2 dark:border-white/15"
            >
              <p class="m-0">
                <span class="font-semibold text-black dark:text-white"
                  >Event:</span
                >
                {winsPageData.featuredTalk.event}
              </p>
              <p class="m-0">
                <span class="font-semibold text-black dark:text-white"
                  >When:</span
                >
                {winsPageData.featuredTalk.date}, {
                  winsPageData.featuredTalk.time
                }
              </p>
              <p class="m-0">
                <span class="font-semibold text-black dark:text-white"
                  >Where:</span
                >
                {winsPageData.featuredTalk.location}
              </p>
              <p class="m-0">
                <span class="font-semibold text-black dark:text-white"
                  >Speakers:</span
                >
                {winsPageData.featuredTalk.speakers}
              </p>
            </div>
            <div class="mt-4">
              <Link href={winsPageData.featuredTalk.url} external>
                View Meetup event
              </Link>
            </div>
          </div>
        </section>

        <section class="animate space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-y-2">
            <h2 class="font-semibold text-black dark:text-white">
              Latest posts
            </h2>
            <Link href="/blog"> See all posts </Link>
          </div>
          <ul class="not-prose grid gap-4 md:grid-cols-2">
            {
              blog.map((post) => (
                <li>
                  <BlogCard post={post} compact thumbnail={post.thumbnail} />
                </li>
              ))
            }
          </ul>
        </section>

        <section class="animate space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-y-2">
            <h2 class="font-semibold text-black dark:text-white">
              Recent projects
            </h2>
            <Link href="/projects"> See all projects </Link>
          </div>
          <ul class="not-prose grid gap-4 sm:grid-cols-2">
            {
              projects.map((project) => (
                <li>
                  <ProjectCard project={project} />
                </li>
              ))
            }
          </ul>
        </section>
      </div>

      <section class="progressive-load space-y-4" style="--load-order: 5">
        <div class="space-y-4">
          <Callout type="chat">
            <h2 class="font-semibold text-black dark:text-white">
              Want to Chat?
            </h2>
          </Callout>
          <article class="space-y-2">
            <p>
              Whether it's about full-stack products, AI engineering, system
              design, or reliability at scale, I'm always up for a good
              conversation.
            </p>
            <p>
              Grab a coffee, poke around, and don't forget to say hi! You can
              find me at:
            </p>
          </article>
          <ul class="not-prose flex flex-wrap gap-2">
            {
              SOCIALS.map((SOCIAL) => (
                <li class="flex gap-x-2 text-nowrap">
                  <Link
                    href={SOCIAL.HREF}
                    external
                    aria-label={`${SITE.TITLE} on ${SOCIAL.NAME}`}
                  >
                    {SOCIAL.NAME}
                  </Link>
                  {"/"}
                </li>
              ))
            }
            <li class="line-clamp-1">
              <Link
                href={`mailto:${SITE.EMAIL}`}
                aria-label={`Email ${SITE.TITLE}`}
              >
                {SITE.EMAIL}
              </Link>
            </li>
          </ul>
        </div>
      </section>
    </aside>
  </Container>
</Layout>

<style>
  .open-to-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .open-to-marquee {
    position: relative;
    flex: 1;
    min-width: 0;
    overflow: hidden;
    padding-block: 0.2rem;
    mask-image: linear-gradient(
      to right,
      transparent 0,
      black 8%,
      black 92%,
      transparent 100%
    );
  }

  .open-to-track {
    display: flex;
    width: max-content;
    animation: open-to-slide 20s linear infinite;
  }

  .open-to-list {
    display: flex;
    flex-shrink: 0;
    gap: 0.5rem;
    padding-right: 0.5rem;
  }

  .open-to-list li {
    display: flex;
    align-items: center;
    list-style: none;
  }

  .work-section-copy {
    max-width: 42rem;
    color: color-mix(in srgb, var(--color-text) 72%, transparent);
    line-height: 1.6;
  }

  .experience-panel {
    width: 100%;
    overflow: hidden;
    scroll-margin-top: 6rem;
    border-top: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
  }

  .experience-header,
  .experience-item summary {
    display: grid;
    grid-template-columns:
      minmax(0, 1.35fr) minmax(0, 0.85fr) minmax(0, 0.9fr)
      2rem;
    align-items: center;
    gap: 1rem;
  }

  .experience-header {
    padding: 0.75rem 1rem;
    color: var(--color-primary);
    font-size: 0.9rem;
    font-weight: 800;
  }

  .experience-list {
    display: grid;
  }

  .experience-item {
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-text) 12%, transparent);
  }

  .experience-item summary {
    cursor: pointer;
    list-style: none;
    padding: 0.8rem 1rem;
    color: color-mix(in srgb, var(--color-text) 78%, transparent);
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .experience-item summary::-webkit-details-marker {
    display: none;
  }

  .experience-item summary:hover,
  .experience-item summary:focus-visible,
  .experience-item[open] summary {
    background: color-mix(in srgb, var(--color-primary) 7%, transparent);
    color: var(--color-text);
  }

  .experience-item summary > span:first-child {
    color: var(--color-text);
    font-weight: 700;
  }

  .experience-item summary a {
    width: fit-content;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .experience-toggle {
    display: grid;
    width: 1.6rem;
    height: 1.6rem;
    place-items: center;
    justify-self: end;
    border: 1px solid color-mix(in srgb, var(--color-text) 18%, transparent);
    border-radius: 999px;
    color: var(--color-primary);
    font-weight: 900;
    line-height: 1;
    transition: transform 160ms ease;
  }

  .experience-item[open] .experience-toggle {
    transform: rotate(45deg);
  }

  .experience-details {
    display: grid;
    gap: 0.8rem;
    padding: 0 1rem 1rem;
  }

  .experience-details ul {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .experience-details li {
    position: relative;
    padding-left: 1.1rem;
    color: color-mix(in srgb, var(--color-text) 72%, transparent);
    line-height: 1.55;
  }

  .experience-details li::before {
    position: absolute;
    left: 0;
    top: 0.62rem;
    width: 0.38rem;
    height: 0.38rem;
    content: "";
    border: 1px solid var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 20%, transparent);
    transform: rotate(45deg);
  }

  .experience-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .experience-chips span {
    border: 1px solid color-mix(in srgb, var(--color-text) 15%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-background) 84%, white);
    color: color-mix(in srgb, var(--color-text) 68%, transparent);
    padding: 0.22rem 0.55rem;
    font-size: 0.8rem;
  }

  @media (max-width: 640px) {
    .experience-header {
      display: none;
    }

    .experience-item summary {
      grid-template-columns: minmax(0, 1fr) 2rem;
      gap: 0.35rem 0.75rem;
    }

    .experience-item summary > span:first-child,
    .experience-item summary a,
    .experience-item summary > span:nth-child(3) {
      grid-column: 1;
    }

    .experience-item summary > span:nth-child(3) {
      color: color-mix(in srgb, var(--color-text) 58%, transparent);
      font-size: 0.85rem;
    }

    .experience-toggle {
      grid-column: 2;
      grid-row: 1 / span 3;
    }
  }

  @keyframes open-to-slide {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .open-to-track {
      animation: none;
    }
  }
</style>
