---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import ArrowCard from "@components/ArrowCard.astro";
import BlogCard from "@components/BlogCard.astro";
import { BLOG } from "@consts";
import { breadcrumbJsonLd, toAbsoluteUrl } from "@lib/seo";
import { isLocalBlogPost, normalizeSeriesKey } from "@lib/blog-series";

const sortedPosts = (
  await getCollection("blog", ({ data }) => !data.draft)
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const seriesCounts = sortedPosts.reduce((acc: Record<string, number>, post) => {
  if (!isLocalBlogPost(post) || !post.data.series) {
    return acc;
  }

  const seriesKey = normalizeSeriesKey(post.data.series);
  if (!seriesKey) {
    return acc;
  }

  acc[seriesKey] = (acc[seriesKey] ?? 0) + 1;
  return acc;
}, {});

const seenSeries = new Set<string>();
const posts = sortedPosts
  .filter((post) => {
    if (!isLocalBlogPost(post) || !post.data.series) {
      return true;
    }

    const seriesKey = normalizeSeriesKey(post.data.series);
    if (!seriesKey) {
      return true;
    }

    if (seenSeries.has(seriesKey)) {
      return false;
    }

    seenSeries.add(seriesKey);
    return true;
  })
  .map((post) => ({
    ...post,
    data: {
      ...post.data,
      seriesPartCount: post.data.series
        ? seriesCounts[normalizeSeriesKey(post.data.series)]
        : undefined,
    },
  }));

const postsByYear = posts.reduce((acc: Record<string, typeof posts>, post) => {
  const year = post.data.date.getFullYear().toString();
  acc[year] ??= [];
  acc[year].push(post);
  return acc;
}, {});

const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));
---

<Layout
  title={BLOG.TITLE}
  description={BLOG.DESCRIPTION}
  keywords={[
    "SRE blog",
    "platform engineering",
    "systems posts",
    "DevOps articles",
  ]}
  schema={[
    breadcrumbJsonLd([
      { name: "Home", path: "/" },
      { name: "Blog", path: "/blog" },
    ]),
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      name: BLOG.TITLE,
      description: BLOG.DESCRIPTION,
      url: toAbsoluteUrl("/blog"),
    },
  ]}
>
  <Container>
    <section class="space-y-6" data-pagefind-ignore>
      <h1 class="sr-only">Blog</h1>
      <div class="flex justify-end">
        <div
          class="inline-flex rounded-lg border border-black/15 bg-black/[0.025] p-1 dark:border-white/20 dark:bg-white/[0.03]"
          aria-label="Blog view"
        >
          <button
            type="button"
            class="blog-view-button rounded-md border border-transparent px-3 py-1.5 text-sm transition-colors"
            data-blog-view-button="list"
            aria-pressed="true"
          >
            List
          </button>
          <button
            type="button"
            class="blog-view-button rounded-md border border-transparent px-3 py-1.5 text-sm transition-colors"
            data-blog-view-button="gallery"
            aria-pressed="false"
          >
            Gallery
          </button>
        </div>
      </div>

      <div class="blog-view-panel space-y-8" data-blog-view-panel="list">
        {
          years.map((year) => (
            <section class="animate space-y-4">
              <div class="font-semibold text-black dark:text-white">{year}</div>
              <ul class="not-prose flex flex-col gap-4">
                {postsByYear[year].map((post) => (
                  <li>
                    <ArrowCard
                      entry={{
                        id: post.id,
                        slug: post.slug,
                        collection: post.collection,
                        data: {
                          ...post.data,
                          body: post.body,
                          redirected: post.data.redirected || false,
                          redirectedUrl: post.data.redirectedUrl,
                        },
                      }}
                    />
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>

      <div class="blog-view-panel" data-blog-view-panel="gallery" hidden>
        <ul class="not-prose grid gap-4 sm:grid-cols-2">
          {
            posts.map((post) => (
              <li>
                <BlogCard post={post} />
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </Container>

  <script is:inline>
    const viewButtons = document.querySelectorAll("[data-blog-view-button]");
    const viewPanels = document.querySelectorAll("[data-blog-view-panel]");

    const setBlogView = (view) => {
      const nextView = view === "gallery" ? "gallery" : "list";

      viewButtons.forEach((button) => {
        const isActive =
          button.getAttribute("data-blog-view-button") === nextView;
        button.setAttribute("aria-pressed", String(isActive));
      });

      viewPanels.forEach((panel) => {
        panel.hidden = panel.getAttribute("data-blog-view-panel") !== nextView;
      });
    };

    viewButtons.forEach((button) => {
      button.addEventListener("click", () => {
        setBlogView(button.getAttribute("data-blog-view-button"));
      });
    });

    setBlogView("list");
  </script>
</Layout>
