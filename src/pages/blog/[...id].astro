---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Layout from "@layouts/Layout.astro";
import BlogCard from "@components/BlogCard.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime, wordCount } from "@lib/utils";
import BackToPrevious from "@components/BackToPrevious.astro";
import PostNavigation from "@components/PostNavigation.astro";
import SeriesNavigation from "@components/SeriesNavigation.astro";
import TableOfContents from "@components/TableOfContents.astro";
import { SITE } from "@consts";
import { getBlogThumbnail } from "@lib/content-images";
import { breadcrumbJsonLd, toAbsoluteUrl } from "@lib/seo";
import { cleanBlogId, getSeriesPosts, isLocalBlogPost } from "@lib/blog-series";
import { shouldIncludeDraftContent } from "@lib/content-visibility";
// import Giscus from "@components/Giscus.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog"))
    .filter((post) => shouldIncludeDraftContent(post.data.draft))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post) => ({
    params: { id: cleanBlogId(post.id) },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const posts = (await getCollection("blog"))
  .filter((post) => shouldIncludeDraftContent(post.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function getNextPost() {
  let postIndex;
  for (const post of posts) {
    if (cleanBlogId(post.id) === Astro.params.id) {
      postIndex = posts.indexOf(post);
      return posts[postIndex + 1];
    }
  }
}

function getPrevPost() {
  let postIndex;
  for (const post of posts) {
    if (cleanBlogId(post.id) === Astro.params.id) {
      postIndex = posts.indexOf(post);
      return posts[postIndex - 1];
    }
  }
}

const nextPost = getNextPost();
const prevPost = getPrevPost();

const post = Astro.props;
const seriesPosts =
  isLocalBlogPost(post) && post.data.series
    ? getSeriesPosts(posts, post.data.series)
    : [];
const currentSeriesIndex = seriesPosts.findIndex(
  (seriesPost) => cleanBlogId(seriesPost.id) === cleanBlogId(post.id),
);
const previousInSeries =
  currentSeriesIndex > 0 ? seriesPosts[currentSeriesIndex - 1] : undefined;
const nextInSeries =
  currentSeriesIndex >= 0 && currentSeriesIndex < seriesPosts.length - 1
    ? seriesPosts[currentSeriesIndex + 1]
    : undefined;
const { Content, headings } = await render(post);
const postPath = `/blog/${cleanBlogId(post.id)}`;
const postUrl = toAbsoluteUrl(postPath);
const postTags = new Set(post.data.tags ?? []);
const relatedPosts = posts
  .filter((candidate) => cleanBlogId(candidate.id) !== cleanBlogId(post.id))
  .map((candidate) => ({
    post: candidate,
    score: (candidate.data.tags ?? []).filter((tag) => postTags.has(tag))
      .length,
  }))
  .filter((candidate) => candidate.score > 0)
  .sort(
    (a, b) =>
      b.score - a.score ||
      b.post.data.date.valueOf() - a.post.data.date.valueOf(),
  )
  .slice(0, 3)
  .map((candidate) => candidate.post);
const postWordCount = post.body ? wordCount(post.body) : 0;
const postImage = getBlogThumbnail(post.id, post.body);
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={postImage}
  ogType="article"
  publishedTime={post.data.date}
  modifiedTime={post.data.date}
  keywords={post.data.tags || ["blog", "sre", "systems"]}
  schema={[
    breadcrumbJsonLd([
      { name: "Home", path: "/" },
      { name: "Blog", path: "/blog" },
      { name: post.data.title, path: postPath },
    ]),
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.date,
      dateModified: post.data.date,
      author: {
        "@type": "Person",
        name: SITE.AUTHOR,
      },
      publisher: {
        "@type": "Person",
        name: SITE.AUTHOR,
      },
      mainEntityOfPage: postUrl,
      url: postUrl,
      image: postImage ? toAbsoluteUrl(postImage) : undefined,
      keywords: (post.data.tags || []).join(", "),
      inLanguage: "en",
    },
  ]}
>
  <div
    class="fixed top-0 right-0 left-0 z-[60] h-1 bg-black/5 dark:bg-white/10"
    aria-hidden="true"
  >
    <div id="reading-progress" class="h-full bg-[var(--color-primary)]"></div>
  </div>
  <Container>
    <div class="animate">
      <BackToPrevious href="/blog">Back to blog</BackToPrevious>
    </div>
    <div class="my-10 space-y-1">
      <div class="animate flex items-center gap-1.5">
        <div class="font-base text-sm">
          <FormattedDate date={post.data.date} />
        </div>
        &bull;
        {
          post.body && (
            <div class="font-base text-sm">{readingTime(post.body)}</div>
          )
        }
      </div>
      <h1 class="animate text-3xl font-semibold text-black dark:text-white">
        {post.data.title}
      </h1>
      {
        post.data.tags && post.data.tags?.length > 0 ? (
          <div class="animate flex flex-wrap gap-2 pt-1">
            {post.data.tags.map((tag) => (
              <a
                href={`/tags/${tag}`}
                class="rounded-sm border border-black/15 px-2 py-1 text-sm break-words whitespace-normal transition-colors duration-300 ease-in-out hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black dark:border-white/20 dark:hover:bg-white/5 dark:hover:text-white dark:focus-visible:bg-white/5 dark:focus-visible:text-white"
              >
                {tag}
              </a>
            ))}
          </div>
        ) : null
      }
      <div
        class="animate mt-5 grid gap-3 rounded-lg border border-black/15 p-4 text-sm md:grid-cols-3 dark:border-white/20"
      >
        <div>
          <p
            class="m-0 text-xs tracking-wide text-black/55 uppercase dark:text-white/55"
          >
            Quest Type
          </p>
          <p class="m-0 mt-1 font-semibold text-black dark:text-white">
            {post.data.series ? "Series Chapter" : "Standalone Run"}
          </p>
        </div>
        <div>
          <p
            class="m-0 text-xs tracking-wide text-black/55 uppercase dark:text-white/55"
          >
            Read Time
          </p>
          <p class="m-0 mt-1 font-semibold text-black dark:text-white">
            {post.body ? readingTime(post.body) : "Quick read"}
          </p>
        </div>
        <div>
          <p
            class="m-0 text-xs tracking-wide text-black/55 uppercase dark:text-white/55"
          >
            Words
          </p>
          <p class="m-0 mt-1 font-semibold text-black dark:text-white">
            {postWordCount.toLocaleString("en-US")}
          </p>
        </div>
      </div>
    </div>
    {
      seriesPosts.length > 1 && (
        <div class="mt-10 mb-6">
          <SeriesNavigation
            currentPost={post}
            seriesPosts={seriesPosts}
            previousInSeries={previousInSeries}
            nextInSeries={nextInSeries}
          />
        </div>
      )
    }
    {headings.length > 0 && <TableOfContents headings={headings} />}
    <article class="animate" data-blog-article>
      <Content />
      {
        seriesPosts.length > 1 && (
          <div class="mt-16">
            <SeriesNavigation
              currentPost={post}
              seriesPosts={seriesPosts}
              previousInSeries={previousInSeries}
              nextInSeries={nextInSeries}
            />
          </div>
        )
      }
      <div class="mt-24">
        <PostNavigation prevPost={prevPost} nextPost={nextPost} path={"blog"} />
      </div>
      {
        relatedPosts.length > 0 && (
          <section class="not-prose mt-24 space-y-4">
            <div class="flex flex-wrap items-end justify-between gap-3">
              <div>
                <p class="m-0 text-xs tracking-wide text-black/55 uppercase dark:text-white/55">
                  Nearby quests
                </p>
                <h2 class="m-0 font-semibold text-black dark:text-white">
                  Related posts
                </h2>
              </div>
              <a href="/blog" class="text-sm">
                Browse all posts
              </a>
            </div>
            <ul class="grid gap-4 md:grid-cols-3">
              {relatedPosts.map((relatedPost) => (
                <li>
                  <BlogCard post={relatedPost} compact />
                </li>
              ))}
            </ul>
          </section>
        )
      }
      <div class="mt-24">
        {/* <Giscus /> */}
      </div>
    </article>
  </Container>
</Layout>

<script is:inline>
  const progressBar = document.getElementById("reading-progress");
  const article = document.querySelector("[data-blog-article]");

  const updateReadingProgress = () => {
    if (
      !(progressBar instanceof HTMLElement) ||
      !(article instanceof HTMLElement)
    ) {
      return;
    }

    const articleTop = article.offsetTop;
    const articleHeight = article.scrollHeight;
    const viewportHeight = window.innerHeight;
    const readableDistance = Math.max(articleHeight - viewportHeight * 0.35, 1);
    const progress = Math.min(
      Math.max(
        (window.scrollY - articleTop + viewportHeight * 0.2) / readableDistance,
        0,
      ),
      1,
    );

    progressBar.style.transform = `scaleX(${progress})`;
  };

  if (progressBar && article) {
    updateReadingProgress();
    document.addEventListener("scroll", updateReadingProgress, {
      passive: true,
    });
    window.addEventListener("resize", updateReadingProgress);
  } else {
    document.documentElement.setAttribute(
      "data-reading-progress",
      "unavailable",
    );
  }
</script>
